# platform 스택 변수 값. 실제 terraform.tfvars 는 ID·ARN 이 들어가므로 .gitignore 대상이다.
# 아래 단계(alb-controller, eso)로 진행하면서 변수가 늘어난다.

# --- cluster 스택 출력값 ---
cluster_name = "parking-guardian"          # cluster: cluster_name

# --- alb-controller: network 스택 출력값 ---
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"            # network: vpc_id

# --- eso: data 스택 출력값 ---
app_secret_arn  = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:parking-guardian/app-xxxxxx"   # data: secret_arns.app
seed_secret_arn = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:parking-guardian/seed-xxxxxx"  # data: secret_arns.seed
rds_secret_arn  = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:rds!db-xxxxxxxx-xxxxxx"        # data: db_master_secret_arn
grafana_secret_arn = "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:parking-guardian/grafana-xxxxxx" # data: secret_arns.grafana
