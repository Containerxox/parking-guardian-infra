# 모든 스택이 공유하는 S3 backend 설정. 실제 파일 backend.hcl 은 계정 ID 가 들어가므로 .gitignore 대상이다.
# bootstrap 스택을 apply 한 뒤 `terraform output -raw backend_hcl` 로 만든다 (README 참고).
# 각 스택의 key 는 스택 안 versions.tf 의 backend "s3" 블록에 고정되어 있다.
bucket       = "parking-guardian-tfstate-<계정ID>"
region       = "ap-northeast-2"
encrypt      = true # SSE-S3(AES-256). KMS 키 없음

use_lockfile = true
